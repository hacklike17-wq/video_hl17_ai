# ===== App =====
NODE_ENV=development
APP_URL=http://localhost:3000

# ===== Auth =====
# Generate with: openssl rand -base64 32
AUTH_SECRET=
ADMIN_EMAIL=admin@example.com
# Generate with: npm run auth:hash -- "your-password"
# IMPORTANT: bcrypt hash chứa "$" — phải escape thành "\$" khi paste vào .env
# Ví dụ: ADMIN_PASSWORD_HASH=\$2a\$12\$abcd...xyz
ADMIN_PASSWORD_HASH=

# ===== DB =====
DATABASE_URL=file:./data/app.db

# ===== Redis (BullMQ) =====
REDIS_URL=redis://localhost:6379

# ===== Cron secret (protects /api/cron/*) =====
CRON_SECRET=

# ===== Webhook secrets =====
ARGIL_WEBHOOK_SECRET=
SUBMAGIC_WEBHOOK_SECRET=

# ===== External APIs =====
# LLM
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Voice (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Avatar (Argil)
ARGIL_API_KEY=

# Trend Mining (Apify)
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper

# Stock B-roll (Pexels)
PEXELS_API_KEY=

# Video Assembly (Submagic)
SUBMAGIC_API_KEY=

# Asset Hosting (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Publishing (Buffer)
BUFFER_ACCESS_TOKEN=
