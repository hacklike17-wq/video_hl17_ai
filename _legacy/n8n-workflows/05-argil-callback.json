{
  "name": "05 — Argil Callback → Trigger Submagic",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "argil-done",
        "responseMode": "responseNode",
        "options": { "rawBody": false }
      },
      "id": "webhook",
      "name": "Webhook (Argil Done)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "// Argil webhook payload may vary — adapt to actual API.\n// Expected fields: id (job), status, videoUrl/url, error\nconst body = $input.first().json.body || $input.first().json;\nconst query = $input.first().json.query || {};\nconst videoId = query.videoId;\nconst status = body.status || 'unknown';\nconst videoUrl = body.videoUrl || body.url || body.output_url || '';\nconst error = body.error || null;\nif (!videoId) throw new Error('Missing videoId in callback query string');\nreturn [{ json: { videoId, status, videoUrl, error, raw: body } }];"
      },
      "id": "parse",
      "name": "Parse Argil Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.status }}", "operation": "equal", "value2": "succeeded" }
          ]
        }
      },
      "id": "check-success",
      "name": "Render Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "base": { "__rl": true, "value": "={{ $env.AIRTABLE_BASE_ID }}", "mode": "id" },
        "table": { "__rl": true, "value": "Videos", "mode": "name" },
        "id": "={{ $json.videoId }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "Argil Failed",
            "reject_reason": "={{ $json.error || 'Argil render failed' }}"
          }
        }
      },
      "id": "mark-failed",
      "name": "Mark Failed",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [860, 460],
      "credentials": { "airtableTokenApi": { "id": "airtable-credential", "name": "Airtable" } }
    },
    {
      "parameters": {
        "operation": "update",
        "base": { "__rl": true, "value": "={{ $env.AIRTABLE_BASE_ID }}", "mode": "id" },
        "table": { "__rl": true, "value": "Videos", "mode": "name" },
        "id": "={{ $('Parse Argil Payload').item.json.videoId }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "avatar_url": "={{ $('Parse Argil Payload').item.json.videoUrl }}",
            "status": "Assembling"
          }
        }
      },
      "id": "save-avatar",
      "name": "Save Avatar URL",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [860, 200],
      "credentials": { "airtableTokenApi": { "id": "airtable-credential", "name": "Airtable" } }
    },
    {
      "parameters": {
        "operation": "get",
        "base": { "__rl": true, "value": "={{ $env.AIRTABLE_BASE_ID }}", "mode": "id" },
        "table": { "__rl": true, "value": "Videos", "mode": "name" },
        "id": "={{ $json.id }}"
      },
      "id": "reload-video",
      "name": "Reload Video Record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1080, 200],
      "credentials": { "airtableTokenApi": { "id": "airtable-credential", "name": "Airtable" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.submagic.co/v1/projects",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.SUBMAGIC_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"Video {{ $json.id }}\",\n  \"templateId\": \"{{ $env.SUBMAGIC_TEMPLATE_ID }}\",\n  \"language\": \"vi\",\n  \"assets\": {\n    \"voice\": \"{{ $json.fields.voice_url }}\",\n    \"avatar\": \"{{ $json.fields.avatar_url }}\",\n    \"broll\": {{ $json.fields.broll_urls || '[]' }}\n  },\n  \"webhook\": \"={{ $env.WEBHOOK_URL }}webhook/submagic-done?videoId={{ $json.id }}\"\n}"
      },
      "id": "submagic",
      "name": "Submagic: Assemble + Caption",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "base": { "__rl": true, "value": "={{ $env.AIRTABLE_BASE_ID }}", "mode": "id" },
        "table": { "__rl": true, "value": "Videos", "mode": "name" },
        "id": "={{ $('Reload Video Record').item.json.id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "submagic_project_id": "={{ $json.id || $json.projectId }}",
            "status": "Rendering"
          }
        }
      },
      "id": "save-submagic-id",
      "name": "Save Submagic Project ID",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1520, 200],
      "credentials": { "airtableTokenApi": { "id": "airtable-credential", "name": "Airtable" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1740, 300]
    }
  ],
  "connections": {
    "Webhook (Argil Done)": { "main": [[{ "node": "Parse Argil Payload", "type": "main", "index": 0 }]] },
    "Parse Argil Payload": { "main": [[{ "node": "Render Succeeded?", "type": "main", "index": 0 }]] },
    "Render Succeeded?": { "main": [
      [{ "node": "Save Avatar URL", "type": "main", "index": 0 }],
      [{ "node": "Mark Failed", "type": "main", "index": 0 }]
    ] },
    "Save Avatar URL": { "main": [[{ "node": "Reload Video Record", "type": "main", "index": 0 }]] },
    "Reload Video Record": { "main": [[{ "node": "Submagic: Assemble + Caption", "type": "main", "index": 0 }]] },
    "Submagic: Assemble + Caption": { "main": [[{ "node": "Save Submagic Project ID", "type": "main", "index": 0 }]] },
    "Save Submagic Project ID": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] },
    "Mark Failed": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
